apiVersion: v1
kind: List
items:
  - apiVersion: v1
    kind: Pod
    metadata:
      name: ${WORKER_NAME}
      namespace: ${NAMESPACE}
      labels: ${WORKER_LABELS}
    spec:
      serviceAccountName: ${SERVICE_ACCOUNT}
      nodeSelector: ${WORKER_NODE_SELECTOR}
      tolerations: ${WORKER_TOLERATIONS}
      priorityClassName: ${PRIORITY_CLASS}
      imagePullSecrets: ${IMAGE_PULL_SECRETS}
      restartPolicy: Never
      activeDeadlineSeconds: 28800
      containers:
        - name: main
          image: ${MX_MAIN_RUNTIME_IMAGE}
          imagePullPolicy: IfNotPresent
          securityContext: ${WORKER_SECURITY_CONTEXT}
          workingDir: /opt/benchmark
          command: [sleep, "28800"]
          env: ${WORKER_ENV}
          envFrom: ${ENV_FROM}
          resources:
            requests: ${WORKER_RESOURCES}
            limits: ${WORKER_RESOURCES}
          volumeMounts:
            - {name: aws-config, mountPath: /etc/aws/config, subPath: config, readOnly: true}
            - {name: weights, mountPath: /models}
            - {name: refit, mountPath: /refit}
            - {name: benchmark, mountPath: /opt/benchmark}
            - {name: shm, mountPath: /dev/shm}
          ports:
            - {containerPort: 8080, name: http}
      volumes:
        - name: aws-config
          configMap: {name: ${AWS_CONFIG_NAME}}
        - {name: weights, emptyDir: {}}
        - {name: refit, emptyDir: {}}
        - name: benchmark
          configMap: {name: ${HARNESS_NAME}}
        - name: shm
          emptyDir: {medium: Memory, sizeLimit: "64Gi"}
      affinity:
        podAntiAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            - labelSelector:
                matchLabels: ${WORKER_MATCH_LABELS}
              topologyKey: kubernetes.io/hostname
  - apiVersion: v1
    kind: Service
    metadata:
      name: ${WORKER_NAME}
      namespace: ${NAMESPACE}
      labels: ${RUN_LABELS}
    spec:
      selector: {app: ${WORKER_NAME}}
      ports: [{port: 8080, targetPort: 8080}]
      publishNotReadyAddresses: true

{
  "context": null,
  "kubeconfig": "/teleport/kubeconfig.yaml",
  "namespace": null,
  "service_account": "default",
  "region": "us-west-2",
  "bucket": "ai-dynamo-modelexpress-ci",
  "endpoint_url": null,
  "addressing_style": "auto",

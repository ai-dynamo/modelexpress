{
  "uid": "modelexpress-overview",
  "title": "ModelExpress",
  "description": "Server lifecycle, gRPC, storage backend and P2P client health.",
  "tags": [
    "modelexpress"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Health",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Server replicas exporting",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "count(mx_build_info{component=\"server\"})",
          "legendFormat": "replicas",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "mx_build_info is registered unconditionally at startup, so this counts pods whose endpoint was scraped -- not pods that are up.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Registry stats age",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "expr": "time() - max(mx_task_last_success_timestamp_seconds{task=\"registry_stats_refresh\"})",
          "legendFormat": "seconds",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "Seconds since the refresh task last SUCCEEDED. The gauges below keep their last good values on a failed pass, so this is the only thing separating a current reading from a frozen one.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Downloads in flight",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(mx_registry_entries{status=\"downloading\"})",
          "legendFormat": "downloading",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "From the gauge, not the transition counters: those are process-local while DOWNLOADING persists in the store, so their difference can go negative after a restart.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Versions deployed",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "expr": "count by (version) (mx_build_info)",
          "legendFormat": "{{version}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "More than one row means a rollout is in progress or stuck.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "row",
      "title": "Download lifecycle",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Download duration",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(mx_download_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(mx_download_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(mx_download_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "Buckets run to one hour: a cold DeepSeek-V3 warm-up is ~40 min.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Downloads finishing",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(mx_download_seconds_count[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Claims by result",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(mx_download_claims_total[$__rate_interval]))",
          "legendFormat": "{{result}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "takeover is the one to watch: a previous downloader died and the bytes are being pulled again -- hundreds of GB for a large model."
    },
    {
      "type": "timeseries",
      "title": "Lease heartbeats",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(mx_download_lease_refresh_total[$__rate_interval]))",
          "legendFormat": "{{result}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "result=lost is the leading indicator of a duplicate download."
    },
    {
      "type": "timeseries",
      "title": "Status transitions",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "sum by (from, to) (rate(mx_registry_status_transitions_total[$__rate_interval]))",
          "legendFormat": "{{from}} -> {{to}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "Flow, not level. Read level from the gauge in the Capacity row."
    },
    {
      "type": "timeseries",
      "title": "Registry entries by status",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "expr": "sum by (status) (mx_registry_entries)",
          "legendFormat": "{{status}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "Refreshed on MX_REGISTRY_STATS_INTERVAL_SECS (default 60s), not at scrape time. Cross-check the Registry stats age panel."
    },
    {
      "type": "row",
      "title": "gRPC",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Request rate by method",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "expr": "sum by (method) (rate(mx_grpc_requests_total[$__rate_interval]))",
          "legendFormat": "{{method}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Error ratio by method",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 23
      },
      "targets": [
        {
          "expr": "sum by (method) (rate(mx_grpc_requests_total{outcome!~\"ok|cancelled|not_found\"}[$__rate_interval])) / sum by (method) (rate(mx_grpc_requests_total[$__rate_interval]))",
          "legendFormat": "{{method}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "cancelled excluded -- that is the caller leaving, not a server fault. If every method lights up at once, suspect the auth path: outcome=backend_error absorbs Code::Unavailable.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "p99 latency by method",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (method, le) (rate(mx_grpc_request_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{method}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "In flight by method",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 23
      },
      "targets": [
        {
          "expr": "sum by (method) (mx_grpc_requests_in_flight)",
          "legendFormat": "{{method}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "type": "text",
      "title": "Why EnsureModelDownloaded is not on this row",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "options": {
        "mode": "markdown",
        "content": "`ModelService/EnsureModelDownloaded`, `ModelService/StreamModelFiles` and `Health/Watch` are **deliberately absent from all three gRPC panels**.\n\nThey are streaming: the metrics layer's future resolves at stream setup, so recording them would report `outcome=\"ok\"` and a sub-millisecond duration for work that can run forty minutes and fail as a stream item. A confidently wrong number is worse than an absent one.\n\n**Download latency is in the Download lifecycle row above**, from `mx_download_seconds`."
      }
    },
    {
      "type": "row",
      "title": "Storage backend",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Operation rate",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 37
      },
      "targets": [
        {
          "expr": "sum by (store, op) (rate(mx_backend_ops_total[$__rate_interval]))",
          "legendFormat": "{{store}}/{{op}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "store is the subsystem (p2p, registry, refit), not the engine. The engine is on mx_build_info{backend=...}.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Error ratio by store",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 37
      },
      "targets": [
        {
          "expr": "sum by (store) (rate(mx_backend_ops_total{result=\"error\"}[$__rate_interval])) / sum by (store) (rate(mx_backend_ops_total[$__rate_interval]))",
          "legendFormat": "{{store}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "p99 latency by store",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 37
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (store, le) (rate(mx_backend_op_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{store}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "In flight",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 37
      },
      "targets": [
        {
          "expr": "sum by (store, op) (mx_backend_ops_in_flight)",
          "legendFormat": "{{store}}/{{op}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "Decremented by a Drop guard on every exit path including cancellation, so a standing value is real rather than drift."
    },
    {
      "type": "row",
      "title": "Client: source selection",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 45
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Selections by policy",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 46
      },
      "targets": [
        {
          "expr": "sum by (policy) (rate(mx_p2p_source_selections_total[$__rate_interval]))",
          "legendFormat": "{{policy}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "Grouped by policy, not source_worker_id: that label only exists when MX_METRICS_SOURCE_ID_LABEL=1, and grouping by an absent label silently collapses every series into one that reads as perfectly balanced."
    },
    {
      "type": "timeseries",
      "title": "Candidate funnel",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 46
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (stage, le) (rate(mx_p2p_candidates_bucket[$__rate_interval])))",
          "legendFormat": "{{stage}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "listed -> rank_matched -> accelerator_matched. The SGLang transfer_engine path never records accelerator_matched, so a gap there is expected rather than a broken exporter."
    },
    {
      "type": "timeseries",
      "title": "Attempts by result",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 46
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(mx_p2p_source_attempts_total[$__rate_interval]))",
          "legendFormat": "{{result}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "Does not partition every candidate: one rejected by the accelerator check is skipped without recording an attempt, so this understates how many peers were passed over."
    },
    {
      "type": "timeseries",
      "title": "ListSources outcomes",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 46
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(mx_p2p_list_sources_total[$__rate_interval]))",
          "legendFormat": "{{result}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "result=error is a backend outage. result=empty is a healthy cluster that has published no peers yet."
    },
    {
      "type": "row",
      "title": "Client: transfer and NIXL health",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 54
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Transfer duration",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 55
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(mx_p2p_transfer_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(mx_p2p_transfer_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(mx_p2p_transfer_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Mean transfer by scheme",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 55
      },
      "targets": [
        {
          "expr": "sum by (scheme) (rate(mx_p2p_transfer_seconds_sum[$__rate_interval])) / sum by (scheme) (rate(mx_p2p_transfer_seconds_count[$__rate_interval]))",
          "legendFormat": "{{scheme}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "scheme is set from MX_METRICS_SCHEME, for comparing benchmark runs.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "NIXL receive outcomes",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 55
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(mx_nixl_receive_total[$__rate_interval]))",
          "legendFormat": "{{result}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "partial and empty both return success to the caller today, so this panel is the only place they are visible."
    },
    {
      "type": "timeseries",
      "title": "NIXL data-plane errors",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 55
      },
      "targets": [
        {
          "expr": "sum by (kind) (rate(mx_nixl_data_plane_errors_total[$__rate_interval]))",
          "legendFormat": "{{kind}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ]
    },
    {
      "type": "text",
      "title": "If this whole section is empty",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 63
      },
      "options": {
        "mode": "markdown",
        "content": "Client metrics are **opt-in and live in the inference engine's pod**, not in the ModelExpress server. An empty section usually means one of:\n\n1. `MX_METRICS_ENABLED=1` is not set on the engine pod (it defaults to off);\n2. nothing is scraping those pods -- the server's PodMonitor does not match them, see `metrics.clientPodMonitor` in the chart;\n3. this deployment does not use P2P at all, in which case empty is correct.\n\n`count(mx_build_info{component=\"client\"})` tells the three apart: present with nothing else means the exporter came up and recorded no events."
      }
    },
    {
      "type": "row",
      "title": "Capacity",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 68
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "In-process map sizes",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 69
      },
      "targets": [
        {
          "expr": "sum by (map) (mx_state_entries)",
          "legendFormat": "{{map}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "Never evicted. This is the OOM early warning."
    },
    {
      "type": "timeseries",
      "title": "Evictions by reason",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 69
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(mx_cache_evictions_total[$__rate_interval]))",
          "legendFormat": "{{reason}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "Only time_threshold and count_limit are reachable today; disk_space and manual exist as label values with no producer."
    },
    {
      "type": "stat",
      "title": "Client processes exporting",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 69
      },
      "targets": [
        {
          "expr": "count(mx_build_info{component=\"client\"})",
          "legendFormat": "clients",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "Proof of life for the client exporter, independent of whether any P2P activity has happened.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    }
  ]

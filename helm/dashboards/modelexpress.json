{
  "uid": "modelexpress-overview",
  "title": "ModelExpress",
  "description": "Server lifecycle, gRPC, storage backend and P2P client health.",
  "tags": [
    "modelexpress"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Health",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Server replicas exporting",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "count(mx_build_info{component=\"server\"})",
          "legendFormat": "replicas",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "mx_build_info is registered unconditionally at startup, so this counts pods whose endpoint was scraped -- not pods that are up.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Registry stats age",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "expr": "max(time() - mx_task_last_success_timestamp_seconds{task=\"registry_stats_refresh\"})",
          "legendFormat": "seconds",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "Age of the STALEST replica\u2019s last successful stats refresh. The aggregation is outside the subtraction on purpose: time() - max(timestamp) is the age of the newest heartbeat, so one healthy replica would mask a wedged one -- the exact failure MXRegistryStatsStale exists to catch. The gauges elsewhere keep their last good values on a failed pass, so if this is high they are frozen rather than current.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Downloads in flight",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "max(mx_registry_entries{status=\"downloading\"})",
          "legendFormat": "downloading",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "max(), not sum(): the gauge is recomputed from the shared store, so every replica publishes the same global total and summing multiplies it by the replica count. From the gauge rather than the transition counters, which are process-local while DOWNLOADING persists in the store.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Server replicas by version",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "expr": "count by (version) (mx_build_info{component=\"server\"})",
          "legendFormat": "{{version}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "Replicas running each version. More than one bar means a rollout is in progress, or stuck.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Download lifecycle",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Download duration, successful (p50 / p95 / p99)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(mx_download_seconds_bucket{outcome=\"downloaded\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(mx_download_seconds_bucket{outcome=\"downloaded\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(mx_download_seconds_bucket{outcome=\"downloaded\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "Filtered to outcome=downloaded. The histogram also carries outcome=error, and a download that fails early would otherwise pull these percentiles down and read as an improvement. Buckets run to one hour: a cold DeepSeek-V3 warm-up is around forty minutes.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Downloads finishing",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum by (outcome) (increase(mx_download_seconds_count[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "description": "Count of downloads reaching a terminal status per interval, not a rate: one download every few minutes expressed per-second is a number nobody can read. Pair with the duration panel -- a steady count with a climbing duration means downloads still finish, but slower."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Claims by result",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum by (result) (increase(mx_download_claims_total{result=~\"claimed|takeover|error\"}[$__rate_interval]))",
          "legendFormat": "{{result}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "Claim outcomes per interval. takeover is the one to watch: a previous downloader died and the model is being pulled again from scratch. result=already_exists is deliberately excluded -- it is produced by each waiting client's 500ms poll loop rather than by contention, so at a few waiters it outweighs takeover by three orders of magnitude and flattens it onto the axis.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Lease heartbeats",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 6
      },
      "targets": [
        {
          "expr": "sum by (result) (increase(mx_download_lease_refresh_total[$__rate_interval]))",
          "legendFormat": "{{result}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "result=lost is the leading indicator of a duplicate download.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Status transitions",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "sum by (from, to) (increase(mx_registry_status_transitions_total[$__rate_interval]))",
          "legendFormat": "{{from}} -> {{to}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "Flow, not level. Read level from the gauge in the Capacity row.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Registry entries by status",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "expr": "max by (status) (mx_registry_entries)",
          "legendFormat": "{{status}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "max(), not sum(): every replica reports the same shared-store total. Refreshed on MX_REGISTRY_STATS_INTERVAL_SECS (default 60s), not at scrape time -- cross-check the Registry stats age panel before trusting the level.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 13,
      "type": "row",
      "title": "gRPC",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "panels": []
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Request rate by method",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "expr": "sum by (method) (rate(mx_grpc_requests_total[$__rate_interval]))",
          "legendFormat": "{{method}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "description": "Per-method request rate. The three streaming RPCs are absent by design -- see the note below this row."
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Error ratio by method",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 23
      },
      "targets": [
        {
          "expr": "sum by (method) (rate(mx_grpc_requests_total{outcome!~\"ok|cancelled|not_found\"}[$__rate_interval])) / sum by (method) (rate(mx_grpc_requests_total[$__rate_interval]))",
          "legendFormat": "{{method}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "cancelled excluded -- that is the caller leaving, not a server fault. If every method lights up at once, suspect the auth path: outcome=backend_error absorbs Code::Unavailable.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "p99 latency by method",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (method, le) (rate(mx_grpc_request_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{method}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "description": "99th percentile handler latency per method. Computed from the counter's histogram, so a cancelled request contributes no sample."
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "In flight by method",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 23
      },
      "targets": [
        {
          "expr": "sum by (method) (mx_grpc_requests_in_flight)",
          "legendFormat": "{{method}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "description": "Requests currently being handled. Decremented by a drop guard on every exit path including cancellation, so a standing value is real."
    },
    {
      "id": 18,
      "type": "text",
      "title": "Why EnsureModelDownloaded is not on this row",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "options": {
        "mode": "markdown",
        "content": "`ModelService/EnsureModelDownloaded`, `ModelService/StreamModelFiles` and `Health/Watch` are **deliberately absent from all four gRPC panels on this row**.\n\nThey are streaming: the metrics layer's future resolves at stream setup, so recording them would report `outcome=\"ok\"` and a sub-millisecond duration for work that can run forty minutes and fail as a stream item. A confidently wrong number is worse than an absent one.\n\nThe in-flight gauge excludes them too, so a running `EnsureModelDownloaded` shows nothing on this row at all \u2014 use **Downloads in flight** in the Health row for that.\n\n**Download latency is in the Download lifecycle row above**, from `mx_download_seconds`."
      }
    },
    {
      "id": 19,
      "type": "row",
      "title": "Storage backend",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "panels": []
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Operation rate",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 37
      },
      "targets": [
        {
          "expr": "sum by (store, op) (rate(mx_backend_ops_total[$__rate_interval]))",
          "legendFormat": "{{store}}/{{op}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "store is the subsystem (p2p, registry, refit), not the engine. The engine is on mx_build_info{backend=...}.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Error ratio by store",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 37
      },
      "targets": [
        {
          "expr": "sum by (store) (rate(mx_backend_ops_total{result=\"error\"}[$__rate_interval])) / sum by (store) (rate(mx_backend_ops_total[$__rate_interval]))",
          "legendFormat": "{{store}} error",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "sum by (store) (rate(mx_backend_ops_total{result=\"cancelled\"}[$__rate_interval])) / sum by (store) (rate(mx_backend_ops_total[$__rate_interval]))",
          "legendFormat": "{{store}} cancelled",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "description": "Failed and cancelled operations as a fraction of all operations for that store. Both lines matter: a cancellation is the caller giving up, so a store that hangs raises the cancelled line while the error line falls. Reading error alone would show a hanging store getting healthier."
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "p99 latency by store",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 37
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (store, le) (rate(mx_backend_op_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{store}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "description": "99th percentile backend operation latency per store. store is the subsystem (p2p, registry, refit), not the storage engine."
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "In flight",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 37
      },
      "targets": [
        {
          "expr": "sum by (store, op) (mx_backend_ops_in_flight)",
          "legendFormat": "{{store}}/{{op}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "Decremented by a Drop guard on every exit path including cancellation, so a standing value is real rather than drift.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 24,
      "type": "row",
      "title": "Client: source selection",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 45
      },
      "panels": []
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Selections by policy",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 46
      },
      "targets": [
        {
          "expr": "sum by (policy) (rate(mx_p2p_source_selections_total[$__rate_interval]))",
          "legendFormat": "{{policy}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "Grouped by policy, not source_worker_id: that label only exists when MX_METRICS_SOURCE_ID_LABEL=1, and grouping by an absent label silently collapses every series into one that reads as perfectly balanced.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "id": 26,
      "type": "bargauge",
      "title": "Candidate funnel (mean per stage)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 46
      },
      "targets": [
        {
          "expr": "sum(rate(mx_p2p_candidates_sum{stage=\"listed\"}[$__rate_interval])) / sum(rate(mx_p2p_candidates_count{stage=\"listed\"}[$__rate_interval]))",
          "legendFormat": "listed",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "sum(rate(mx_p2p_candidates_sum{stage=\"rank_matched\"}[$__rate_interval])) / sum(rate(mx_p2p_candidates_count{stage=\"rank_matched\"}[$__rate_interval]))",
          "legendFormat": "rank_matched",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "sum(rate(mx_p2p_candidates_sum{stage=\"accelerator_matched\"}[$__rate_interval])) / sum(rate(mx_p2p_candidates_count{stage=\"accelerator_matched\"}[$__rate_interval]))",
          "legendFormat": "accelerator_matched",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "Mean candidates surviving each selection stage. The mean, not a quantile: the buckets are 0,1,2,4,8..., and histogram_quantile interpolates inside a bucket, so it reports fractional candidates for a quantity that is always a whole number. Bars should narrow left to right; the SGLang transfer-engine path never records accelerator_matched, so a missing third bar is expected rather than a broken exporter.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      }
    },
    {
      "id": 27,
      "type": "timeseries",
      "title": "Attempts by result",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 46
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(mx_p2p_source_attempts_total[$__rate_interval]))",
          "legendFormat": "{{result}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "Does not partition every candidate: one rejected by the accelerator check is skipped without recording an attempt, so this understates how many peers were passed over.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "id": 28,
      "type": "timeseries",
      "title": "ListSources outcomes",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 46
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(mx_p2p_list_sources_total[$__rate_interval]))",
          "legendFormat": "{{result}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "result=error is a backend outage. result=empty is a healthy cluster that has published no peers yet.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "id": 29,
      "type": "row",
      "title": "Client: transfer and NIXL health",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 54
      },
      "panels": []
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Transfer duration, successful (p50 / p95 / p99)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 55
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(mx_p2p_transfer_seconds_bucket{outcome=\"success\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(mx_p2p_transfer_seconds_bucket{outcome=\"success\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(mx_p2p_transfer_seconds_bucket{outcome=\"success\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "description": "Filtered to outcome=success. retry and fallback samples are the elapsed time of attempts that did not deliver, so including them measures how long failures take and reports it as transfer latency."
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Mean transfer by scheme",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 55
      },
      "targets": [
        {
          "expr": "sum by (scheme) (rate(mx_p2p_transfer_seconds_sum{outcome=\"success\"}[$__rate_interval])) / sum by (scheme) (rate(mx_p2p_transfer_seconds_count{outcome=\"success\"}[$__rate_interval]))",
          "legendFormat": "{{scheme}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "Mean successful transfer time, for comparing benchmark runs; scheme comes from MX_METRICS_SCHEME. Filtered to outcome=success for the same reason as the panel to its left.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "NIXL receive outcomes",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 55
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(mx_nixl_receive_total[$__rate_interval]))",
          "legendFormat": "{{result}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "partial and empty both return success to the caller today, so this panel is the only place they are visible.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "NIXL data-plane errors",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 55
      },
      "targets": [
        {
          "expr": "sum by (kind) (increase(mx_nixl_data_plane_errors_total[$__rate_interval]))",
          "legendFormat": "{{kind}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "description": "NIXL failures by classified kind. A non-zero count is what demotes an agent from READY."
    },
    {
      "id": 34,
      "type": "text",
      "title": "If this whole section is empty",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 63
      },
      "options": {
        "mode": "markdown",
        "content": "Client metrics are **opt-in and live in the inference engine's pod**, not in the ModelExpress server. An empty section usually means one of:\n\n1. `MX_METRICS_ENABLED=1` is not set on the engine pod (it defaults to off);\n2. nothing is scraping those pods -- the server's PodMonitor does not match them, see `metrics.clientPodMonitor` in the chart;\n3. this deployment does not use P2P at all, in which case empty is correct.\n\n`count(mx_build_info{component=\"client\"})` tells the three apart: present with nothing else means the exporter came up and recorded no events."
      }
    },
    {
      "id": 35,
      "type": "row",
      "title": "Capacity",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 68
      },
      "panels": []
    },
    {
      "id": 36,
      "type": "timeseries",
      "title": "In-process map sizes",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 69
      },
      "targets": [
        {
          "expr": "sum by (map) (mx_state_entries)",
          "legendFormat": "{{map}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "Never evicted. This is the OOM early warning.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 37,
      "type": "timeseries",
      "title": "Evictions by reason",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 69
      },
      "targets": [
        {
          "expr": "sum by (reason) (increase(mx_cache_evictions_total[$__rate_interval]))",
          "legendFormat": "{{reason}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "Only time_threshold and count_limit are reachable today; disk_space and manual exist as label values with no producer.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 38,
      "type": "stat",
      "title": "Client pods exporting",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 69
      },
      "targets": [
        {
          "expr": "count(mx_build_info{component=\"client\"})",
          "legendFormat": "pods",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "Pods, not ranks. Multiprocess mode merges every rank in a pod into one endpoint with no pid label, so a TP=8 pod contributes exactly one series. Proof of life for the client exporter, independent of whether any P2P activity has happened.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    }
  ]
}

{
  "uid": "modelexpress-overview",
  "title": "ModelExpress",
  "description": "Server lifecycle, gRPC, storage backend and P2P client health.",
  "tags": [
    "modelexpress"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Server replicas exporting",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "count(mx_build_info{component=\"server\"})",
          "legendFormat": "replicas",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "mx_build_info is registered unconditionally at startup, so this counts pods whose endpoint was scraped -- not pods that are up.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "0"
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Registry stats age",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "expr": "max(time() - mx_task_last_success_timestamp_seconds{task=\"registry_stats_refresh\"})",
          "legendFormat": "seconds",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "Age of the STALEST replica\u2019s last successful stats refresh. The aggregation is outside the subtraction on purpose: time() - max(timestamp) is the age of the newest heartbeat, so one healthy replica would mask a wedged one -- the exact failure MXRegistryStatsStale exists to catch. The gauges elsewhere keep their last good values on a failed pass, so if this is high they are frozen rather than current.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 300
              },
              {
                "color": "red",
                "value": 600
              }
            ]
          },
          "noValue": "never run"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "auto"
      }
    },
    {
      "id": 101,
      "type": "stat",
      "title": "Downloads in flight",
      "description": "From the gauge, not the transition counters: those are process-local while DOWNLOADING persists in the shared store. max(), not sum(), because every replica republishes the same shared total.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "max(mx_registry_entries{status=\"downloading\"})",
          "legendFormat": "",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "0",
          "decimals": 0
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 102,
      "type": "stat",
      "title": "Downloads completed",
      "description": "Successful downloads in the selected range. Process-local, so a restart resets it.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(increase(mx_download_seconds_count{outcome=\"downloaded\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "0",
          "decimals": 0
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 103,
      "type": "stat",
      "title": "Download failures",
      "description": "Downloads that ended in ERROR. MXDownloadFailureRatio alerts when these exceed a tenth of all downloads.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "sum(increase(mx_download_seconds_count{outcome=\"error\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "noValue": "0",
          "decimals": 0
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 104,
      "type": "stat",
      "title": "Takeovers",
      "description": "A previous downloader died and the model is being pulled again from scratch -- hundreds of GB for a large one. MXDownloadTakeover fires on the first. The counter is pre-created at zero so the first one is visible.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 5
      },
      "targets": [
        {
          "expr": "sum(increase(mx_download_claims_total{result=\"takeover\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "noValue": "0",
          "decimals": 0
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 105,
      "type": "stat",
      "title": "Leases lost",
      "description": "A downloader stopped heartbeating; the documented leading indicator of a duplicate download. MXDownloadLeaseLost fires on this.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "expr": "sum(increase(mx_download_lease_refresh_total{result=\"lost\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          },
          "noValue": "0",
          "decimals": 0
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 106,
      "type": "stat",
      "title": "gRPC errors",
      "description": "Requests that failed for a reason the server owns. cancelled is the caller leaving and not_found is a legitimate answer, so both are excluded -- the same exclusion MXGrpcErrorRatio uses.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 5
      },
      "targets": [
        {
          "expr": "sum(increase(mx_grpc_requests_total{outcome!~\"ok|cancelled|not_found\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "noValue": "0",
          "decimals": 0
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 110,
      "type": "row",
      "title": "Model load",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 111,
      "type": "timeseries",
      "title": "Load duration by model",
      "description": "Mean load_model() duration per model, over the processes currently being scraped. Not the inference cold start: CUDA graph capture, JIT and KV cache setup all run after the loader returns.\n\nThe mean rather than a quantile, and cumulative rather than a rate, because of what these series are. A load happens once per process, so rate() sees a constant and returns zero, and each pod contributes a single observation. histogram_quantile reads bucket counts only, so two models landing in one bucket draw the same line -- a 36 s load and a 44 s load are indistinguishable inside (30, 60]. _sum / _count is exact.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "expr": "sum by (model) (mx_load_seconds_sum) / sum by (model) (mx_load_seconds_count)",
          "legendFormat": "{{model}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "0"
        }
      }
    },
    {
      "id": 112,
      "type": "timeseries",
      "title": "Where the load went (mean per phase)",
      "description": "Mean time in each phase. The phases partition the load, so these stack to the whole; this is the panel that answers 'which part was slow'. A phase absent for an engine is a real absence, not a zero: SGLang has no model_init, and TRT-LLM publishes outside this window. A load happens once per process, so rate() over these series sees a constant and returns zero -- the cumulative value is the reading that means anything.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "targets": [
        {
          "expr": "sum by (phase) (mx_load_phase_seconds_sum) / sum by (phase) (mx_load_phase_seconds_count)",
          "legendFormat": "{{phase}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "0"
        }
      }
    },
    {
      "id": 113,
      "type": "timeseries",
      "title": "Loads recorded by model",
      "description": "Loads completed by the processes currently being scraped, by model. Resets when a pod restarts, because the count is process-local.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "expr": "sum by (model) (mx_load_seconds_count)",
          "legendFormat": "{{model}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0"
        }
      }
    },
    {
      "id": 114,
      "type": "timeseries",
      "title": "Phase share of the load",
      "description": "Each phase's share of total load time. Sums to at most 1 by construction; a total well under 1 means time is going somewhere no phase covers, which is a gap in the instrumentation rather than in the load. SGLang's transfer_engine transport reads 0 here, correctly: it never enters the strategy chain and records no phases.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "targets": [
        {
          "expr": "sum by (phase) (mx_load_phase_seconds_sum) / scalar(sum(mx_load_seconds_sum))",
          "legendFormat": "{{phase}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "0"
        }
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Downloads",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Download duration, successful (p50 / p95 / p99)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 27
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (mx_download_seconds_bucket{outcome=\"downloaded\"}))",
          "legendFormat": "p50",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (mx_download_seconds_bucket{outcome=\"downloaded\"}))",
          "legendFormat": "p95",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (mx_download_seconds_bucket{outcome=\"downloaded\"}))",
          "legendFormat": "p99",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "Duration of every successful download these server processes have done. Cumulative rather than a rate: a download is a rare event, and over the few-minute window $__rate_interval covers, the panel would be empty except in the moments just after one finished. Does not decay -- a slow download keeps affecting the quantiles until the process restarts.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Downloads finishing",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 27
      },
      "targets": [
        {
          "expr": "sum by (outcome) (increase(mx_download_seconds_count[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "description": "Count of downloads reaching a terminal status per interval, not a rate: one download every few minutes expressed per-second is a number nobody can read. Pair with the duration panel -- a steady count with a climbing duration means downloads still finish, but slower."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Claims by result",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 27
      },
      "targets": [
        {
          "expr": "sum by (result) (increase(mx_download_claims_total{result=~\"claimed|takeover|error\"}[$__rate_interval]))",
          "legendFormat": "{{result}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "Claim outcomes per interval. takeover is the one to watch: a previous downloader died and the model is being pulled again from scratch. result=already_exists is deliberately excluded -- it is produced by each waiting client's 500ms poll loop rather than by contention, so at a few waiters it outweighs takeover by three orders of magnitude and flattens it onto the axis.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Lease heartbeats",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 27
      },
      "targets": [
        {
          "expr": "sum by (result) (increase(mx_download_lease_refresh_total[$__rate_interval]))",
          "legendFormat": "{{result}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "result=lost is the leading indicator of a duplicate download.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Status transitions",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "targets": [
        {
          "expr": "sum by (from, to) (increase(mx_registry_status_transitions_total[$__rate_interval])) > 0",
          "legendFormat": "{{from}} -> {{to}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "Transitions that occurred in the window. Filtered to non-zero: the counters are pre-created at zero for all sixteen from/to pairs so increase() can see a first event, and without the filter the flat ones crowd out the flow. Level belongs to Registry entries by status -- these counters are process-local while the status lives in the shared store.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Registry entries by status",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "targets": [
        {
          "expr": "max by (status) (mx_registry_entries)",
          "legendFormat": "{{status}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "max(), not sum(): every replica reports the same shared-store total. Refreshed on MX_REGISTRY_STATS_INTERVAL_SECS (default 60s), not at scrape time -- cross-check the Registry stats age panel before trusting the level.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 13,
      "type": "row",
      "title": "Server internals",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 43
      },
      "panels": []
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "gRPC request rate",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 44
      },
      "targets": [
        {
          "expr": "sum by (method) (rate(mx_grpc_requests_total[$__rate_interval]))",
          "legendFormat": "{{method}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "description": "Per-method request rate. The three streaming RPCs are absent by design -- see the note below this row."
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "gRPC error ratio",
      "datasource": {
        "type": "prometheus",

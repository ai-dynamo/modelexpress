# syntax=docker/dockerfile:1.7
# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
# SPDX-License-Identifier: Apache-2.0
#
# Builds the modelexpress Python client distributions for the target
# platform (linux/amd64 or linux/arm64):
#   - manylinux_2_28 wheels for cp310, cp311, cp312, cp313 (each compiles
#     the modelexpress.vmm._alloc_ext shim and the
#     modelexpress_rl.inference._delta_ext delta checker against the
#     matching CPython ABI and is hardened with `auditwheel repair`)
#   - py3-none-any pure-Python wheel built with MX_SKIP_EXT=1 (no compiled
#     extensions; runtime falls back to the pool-reg path and to checking
#     refit deltas in Python)
#   - sdist tarball (.tar.gz)
#
# Multi-arch: pick the platform with buildx --platform. See
# docs/DEPLOYMENT.md for the full invocation examples.

# Base images pinned by digest for reproducible release builds.
# Digests track the manylinux_2_28 `latest` tag as of 2026-05-30.
# Refresh with: docker buildx imagetools inspect quay.io/pypa/manylinux_2_28_<arch>
FROM quay.io/pypa/manylinux_2_28_x86_64@sha256:6c62d0cc6477b491315d96026357c7927e523d63c50c1b4636dd59ce73ddde93 AS builder-amd64
FROM quay.io/pypa/manylinux_2_28_aarch64@sha256:9cb0c7e71b5697e298dc74b7af6e4ee8763355374e64fb83e45b22455089c83d AS builder-arm64

ARG TARGETARCH
FROM builder-${TARGETARCH} AS builder

WORKDIR /src
COPY modelexpress_client/python /src

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PATH="/opt/python/cp313-cp313/bin:${PATH}"

# uv drives the per-Python builds (PEP 517, with build isolation).
# auditwheel only needs to live in one Python; it operates on built wheels.
# auditwheel is pinned: it sets the platform tag and vendors libs into the
# repaired wheel, so its version directly affects the published artifact.
RUN /opt/python/cp313-cp313/bin/pip install --upgrade uv auditwheel==6.7.0

# The delta checker decompresses refit deltas with libzstd, linked statically
# from a pinned release: the system's zstd 1.4 decodes about a fifth slower.
ARG ZSTD_VERSION=1.5.7
ARG ZSTD_SHA256=eb33e51f49a15e023950cd7825ca74a4a2b43db8354825ac24fc1b7ee09e6fa3
RUN set -eux; \
    curl -fsSL -o /tmp/zstd.tar.gz \
        "https://github.com/facebook/zstd/releases/download/v${ZSTD_VERSION}/zstd-${ZSTD_VERSION}.tar.gz"; \
    echo "${ZSTD_SHA256}  /tmp/zstd.tar.gz" | sha256sum -c -; \
    tar xzf /tmp/zstd.tar.gz -C /tmp; \
    make -C "/tmp/zstd-${ZSTD_VERSION}/lib" -j"$(nproc)" libzstd.a CFLAGS="-O3 -fPIC"; \
    make -C "/tmp/zstd-${ZSTD_VERSION}/lib" install-static install-includes PREFIX=/usr/local; \
    rm -rf /tmp/zstd.tar.gz "/tmp/zstd-${ZSTD_VERSION}"
ENV CPATH=/usr/local/include \
    LIBRARY_PATH=/usr/local/lib

RUN set -eux; \
    arch=$(uname -m); \
    mkdir -p /tmp/raw /dist; \
    for PY in /opt/python/cp310-cp310/bin/python \
              /opt/python/cp311-cp311/bin/python \
              /opt/python/cp312-cp312/bin/python \
              /opt/python/cp313-cp313/bin/python; do \
        uv build --wheel --python "$PY" --out-dir /tmp/raw .; \
    done; \
    for whl in /tmp/raw/*.whl; do \
        auditwheel repair --plat "manylinux_2_28_${arch}" -w /dist "$whl"; \
    done

# Extensions are optional at install time, but a platform wheel must carry them.
RUN set -eux; \
    for whl in /dist/*manylinux*.whl; do \
        for ext in modelexpress/vmm/_alloc_ext modelexpress_rl/inference/_delta_ext; do \
            python -m zipfile -l "$whl" | grep -qE "${ext}\.cpython-[^ ]+\.so" \
                || { echo "$whl lacks $ext" >&2; exit 1; }; \
        done; \
    done

RUN set -eux; \
    MX_SKIP_EXT=1 uv build --wheel --sdist \
        --python /opt/python/cp313-cp313/bin/python --out-dir /dist .; \
    rm -f /dist/.gitignore

FROM scratch AS export
COPY --from=builder /dist/ /
